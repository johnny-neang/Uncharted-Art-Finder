<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sacramento Artist Directory — Arden Fair UnchARTed · UpperCloud Studio</title>
<meta name="description" content="A curated directory of 21 Sacramento-area artists and art agencies, evaluated for the Arden Fair UnchARTed program by UpperCloud Studio.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=IBM+Plex+Sans:wght@300;400;500;600&family=Unbounded:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ---------- UpperCloud Brand System (BG—2026.001) ---------- */
:root {
  /* Surfaces */
  --paper: #F5F3EE;
  --paper-2: #EBE7DF;
  --paper-3: #FBF8F2;
  --ink: #1A1A1A;
  --ink-2: #4A4A4A;
  --ink-3: #8A8A8A;
  --rule: rgba(26,26,26,0.15);
  --rule-soft: rgba(26,26,26,0.08);

  /* Inverse */
  --obsidian: #161310;
  --obsidian-2: #2A2522;

  /* Accents — landmarks, not decoration */
  --marigold: #E89A1C;
  --marigold-soft: rgba(232,154,28,0.12);
  --jade: #1F8A76;
  --jade-soft: rgba(31,138,118,0.10);
  --cyan: #23B4D8;

  /* Type families */
  --font-display: "DM Serif Display", "Iowan Old Style", Georgia, serif;
  --font-body: "IBM Plex Sans", system-ui, -apple-system, sans-serif;
  --font-label: "Unbounded", system-ui, sans-serif;

  /* Spacing scale (multiples of 4) */
  --s1: 4px;  --s2: 8px;  --s3: 12px; --s4: 18px;
  --s5: 24px; --s6: 28px; --s7: 36px; --s8: 48px;
  --s9: 64px; --s10: 72px;

  --shadow-card: 0 1px 0 rgba(26,26,26,0.04), 0 8px 24px -10px rgba(26,26,26,0.10);
  --shadow-thumb: inset 0 0 0 1px rgba(26,26,26,0.06);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.55;
  color: var(--ink-2);
  background: var(--paper);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* ---------- Layout ---------- */
.shell { max-width: 1320px; margin: 0 auto; padding: 0 var(--s6); }

/* ---------- Top bar (header chrome — wordmark left, meta right) ---------- */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--s6) 0 var(--s5);
  border-bottom: 1px solid var(--rule-soft);
}
.wm img { height: 28px; display: block; }
.topbar-meta {
  display: flex; gap: var(--s7); align-items: baseline;
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
}
.topbar-meta b { color: var(--ink); font-weight: 500; }

/* ---------- Hero (cover-style) ---------- */
.hero {
  padding: var(--s10) 0 var(--s8);
  border-bottom: 1px solid var(--ink);
  position: relative;
}
.hero-figno {
  font-family: var(--font-label); font-weight: 500;
  font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--marigold);
  margin-bottom: var(--s2);
}
.hero-doctype {
  font-family: var(--font-label); font-weight: 500;
  font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--ink-2);
  margin-bottom: var(--s7);
}
.hero-grid {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: var(--s8);
  align-items: end;
}
.hero h1 {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(48px, 7vw, 96px);
  line-height: 0.96;
  letter-spacing: -0.025em;
  margin: 0 0 var(--s4);
  color: var(--ink);
  max-width: 14ch;
}
.hero h1 em {
  font-style: italic; color: var(--jade);
}
.hero-lede {
  font-family: var(--font-body); font-weight: 300;
  font-size: 18px; line-height: 1.5; color: var(--ink);
  max-width: 56ch;
  margin: 0;
}
.hero-meta {
  border-top: 1px solid var(--ink);
  padding-top: var(--s5);
  display: grid; grid-template-columns: 1fr; gap: var(--s4);
}
.hero-meta dl { margin: 0; display: grid; grid-template-columns: 1fr; gap: var(--s4); }
.hero-meta dt {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3); margin-bottom: var(--s1);
}
.hero-meta dd {
  margin: 0;
  font-family: var(--font-body); font-size: 16px; color: var(--ink);
}

/* ---------- Stats strip ---------- */
.stats {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  border-bottom: 1px solid var(--rule);
}
.stat {
  padding: var(--s5) var(--s5) var(--s4);
  border-right: 1px solid var(--rule-soft);
}
.stat:last-child { border-right: 0; }
.stat-num {
  font-family: var(--font-display);
  font-size: 48px;
  line-height: 1;
  color: var(--ink);
  margin-bottom: var(--s1);
  letter-spacing: -0.02em;
}
.stat-num em { font-style: italic; color: var(--marigold); }
.stat-lbl {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
}

/* ---------- Filters / toolbar ---------- */
.toolbar {
  display: flex;
  align-items: center;
  gap: var(--s4);
  padding: var(--s5) 0 var(--s4);
  border-bottom: 1px solid var(--rule-soft);
  flex-wrap: wrap;
}
.toolbar-label {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--ink-3);
  margin-right: var(--s1);
}
.chip {
  display: inline-flex; align-items: center; gap: var(--s2);
  padding: 6px var(--s3);
  border: 1px solid var(--rule);
  background: transparent;
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-2);
  cursor: pointer;
  transition: all 0.15s;
  user-select: none;
  line-height: 1.6;
}
.chip:hover { color: var(--ink); border-color: var(--ink); }
.chip[aria-pressed="true"] {
  background: var(--ink); color: var(--paper); border-color: var(--ink);
}
.chip .chip-count {
  font-size: 9px; opacity: 0.6; font-weight: 400; letter-spacing: 0.1em;
}
.search-wrap { margin-left: auto; }
.search {
  border: 1px solid var(--rule);
  background: transparent;
  padding: 7px var(--s3);
  font-size: 13px;
  font-family: var(--font-body);
  color: var(--ink);
  width: 240px;
}
.search:focus { outline: none; border-color: var(--ink); }
.search::placeholder {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
}

/* ---------- Section eyebrow (NN — LABEL — JADE RULE) ---------- */
.section-head {
  padding: var(--s8) 0 var(--s5);
  margin-bottom: var(--s6);
}
.eyebrow {
  display: flex; align-items: center; gap: var(--s4);
  margin-bottom: var(--s4);
}
.eyebrow .num {
  font-family: var(--font-label); font-weight: 500;
  font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--marigold);
}
.eyebrow .lbl {
  font-family: var(--font-label); font-weight: 500;
  font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--ink);
}
.eyebrow .line { flex: 1; height: 1px; background: var(--jade); }
.eyebrow .meta {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
}
.section-title {
  font-family: var(--font-display);
  font-size: 38px;
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: -0.015em;
  margin: 0;
  color: var(--ink);
}
.section-title em { font-style: italic; color: var(--jade); }
.section-meta { font-family: var(--font-label); font-weight: 500; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-3); }

/* ---------- Card grid ---------- */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--s6);
  padding-bottom: var(--s10);
}
@media (max-width: 920px) {
  .grid { grid-template-columns: 1fr; }
  .hero-grid { grid-template-columns: 1fr; }
  .stats { grid-template-columns: repeat(2, 1fr); }
}

.card {
  background: var(--paper);
  border: 1px solid var(--rule);
  padding: var(--s5);
  display: flex; flex-direction: column;
  position: relative;
  transition: border-color 0.15s;
  box-shadow: var(--shadow-card);
}
.card:hover { border-color: var(--ink); }
.card.is-hidden { display: none; }

.card-head {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: var(--s4);
  margin-bottom: var(--s3);
}
.card-num {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--marigold);
  margin-bottom: var(--s1);
}
.card-name {
  font-family: var(--font-display);
  font-size: 28px;
  line-height: 1.05;
  font-weight: 400;
  margin: 0 0 var(--s1);
  letter-spacing: -0.015em;
  color: var(--ink);
}
.card-name em { font-style: italic; color: var(--jade); }
.card-sub {
  font-size: 12px; color: var(--ink-2);
  display: flex; gap: var(--s2); align-items: center; flex-wrap: wrap;
}

.tier-badge {
  display: inline-flex; align-items: center; gap: var(--s1);
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 4px var(--s2);
  white-space: nowrap;
  flex-shrink: 0;
  border: 1px solid;
}
.tier-1 { color: var(--marigold); border-color: var(--marigold); background: var(--marigold-soft); }
.tier-2 { color: var(--jade); border-color: var(--jade); background: var(--jade-soft); }
.tier-3 { color: var(--ink-2); border-color: var(--rule); background: transparent; }

.kind-pill {
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3); padding: 3px 0;
}

/* ---------- Thumb grid ---------- */
.thumb-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s2);
  margin: var(--s1) 0 var(--s4);
}
.thumb {
  position: relative;
  aspect-ratio: 4 / 3;
  background: var(--paper-2);
  overflow: hidden;
  box-shadow: var(--shadow-thumb);
}
.thumb svg, .thumb img { width: 100%; height: 100%; display: block; }
.thumb img { object-fit: cover; object-position: center; }
.thumb-label {
  position: absolute;
  left: var(--s2); bottom: var(--s2);
  font-family: var(--font-label); font-weight: 500;
  font-size: 8px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  background: rgba(26, 26, 26, 0.82);
  color: var(--paper);
  padding: 3px 7px;
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
}

/* ---------- Card body ---------- */
.card-summary {
  font-size: 13px;
  line-height: 1.55;
  color: var(--ink-2);
  margin: 0 0 var(--s4);
}
.card-meta-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s3);
  font-size: 12px;
  margin-top: auto;
  padding-top: var(--s3);
  border-top: 1px solid var(--rule-soft);
}
.card-meta-cell { display: flex; flex-direction: column; gap: var(--s1); }
.card-meta-cell dt {
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
}
.card-meta-cell dd {
  font-family: var(--font-body); font-size: 12px; color: var(--ink); margin: 0;
}

.fit-bar {
  display: flex; align-items: center; gap: var(--s2);
}
.fit-dots { display: flex; gap: 2px; }
.fit-dot {
  width: 6px; height: 6px; background: var(--rule);
}
.fit-dot.on { background: var(--marigold); }
.fit-num { font-family: var(--font-label); font-weight: 500; font-size: 9px; letter-spacing: 0.18em; color: var(--ink-3); text-transform: uppercase; }

.card-foot {
  margin-top: auto;
  padding-top: var(--s4);
  border-top: 1px solid var(--rule-soft);
  display: flex; flex-direction: column;
  gap: var(--s3);
  font-size: 12px;
}
.card-foot-action {
  display: flex; align-items: center;
  gap: var(--s3);
}
.card-link {
  flex: 0 0 auto;
  max-width: 45%;
  color: var(--ink-2); text-decoration: none;
  border-bottom: 1px solid var(--rule);
  padding-bottom: 1px;
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.card-link:hover { color: var(--jade); border-bottom-color: var(--jade); }
.card-link::after { content: " →"; }
.card-tags { display: flex; gap: var(--s1); flex-wrap: wrap; }
.tag {
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-2); padding: 2px var(--s2);
  border: 1px solid var(--rule);
}

/* ---------- Footer ---------- */
.footer {
  border-top: 1px solid var(--ink);
  padding: var(--s8) 0 var(--s9);
  margin-top: var(--s5);
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: var(--s8);
  font-size: 13px;
  color: var(--ink-2);
}
.footer h4 {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--ink); margin: 0 0 var(--s3);
}
.footer p { margin: 0 0 var(--s2); line-height: 1.55; }
.footer-meta {
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
}
.footer-meta b { color: var(--ink); font-weight: 500; }
.footer .pg {
  font-family: var(--font-display); font-size: 22px;
  letter-spacing: 0; text-transform: none; color: var(--ink);
}


/* ---------- Recent Candidates (rendered with unified .card style) ---------- */
.discoveries-section { padding: var(--s8) 0 0; }
.candidate-filter-row {
  display: flex; align-items: center; flex-wrap: wrap; gap: var(--s2);
  margin: var(--s4) 0 var(--s5);
}
.candidate-filter-chip {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  padding: 6px var(--s3);
  border: 1px solid var(--rule);
  background: transparent;
  color: var(--ink-2);
  cursor: pointer;
  transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}
.candidate-filter-chip:hover { border-color: var(--ink); color: var(--ink); }
.candidate-filter-chip[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.candidate-filter-chip[data-state="add"][aria-pressed="true"]     { background: var(--marigold); border-color: var(--marigold); color: #fff; }
.candidate-filter-chip[data-state="watch"][aria-pressed="true"]   { background: var(--jade);     border-color: var(--jade);     color: #fff; }
.candidate-filter-chip[data-state="reject"][aria-pressed="true"]  { background: var(--ink-3);    border-color: var(--ink-3);    color: var(--paper); }
.candidate-filter-chip[data-state="pending"][aria-pressed="true"] { background: var(--ink);      border-color: var(--ink);      color: var(--paper); }
.candidate-filter-chip .chip-count { color: inherit; opacity: 0.55; margin-left: 6px; font-size: 9px; font-weight: 400; letter-spacing: 0.1em; }
.discovery-empty-state {
  padding: var(--s6); border: 1px dashed var(--rule);
  color: var(--ink-3); font-style: italic; text-align: center;
  display: none;
}
.discovery-empty-state.is-on { display: block; }
.submit-url-cta {
  display: inline-flex; align-items: center; gap: 8px;
  margin-top: var(--s4);
  padding: 10px 18px;
  border: 1px solid var(--jade);
  border-radius: 999px;
  font-family: var(--font-label); font-weight: 500;
  font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--jade);
  text-decoration: none;
  transition: background-color 0.15s ease, color 0.15s ease;
}
.submit-url-cta:hover { background: var(--jade); color: #fff; }
.submit-url-cta .plus { font-size: 16px; line-height: 1; margin-top: -2px; }
.submit-url-cta .hint { color: var(--ink-3); margin-left: 12px; font-size: 10px; letter-spacing: 0.14em; }

/* ---------- Card action button (Promote / Move back to Candidates) ---------- */
.card-action {
  flex: 1 1 auto;
  display: inline-flex; align-items: center; justify-content: space-between;
  gap: var(--s2);
  min-height: 40px;
  padding: 10px var(--s4);
  font-family: var(--font-label); font-weight: 500;
  font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
  border: 1px solid var(--ink);
  background: var(--paper);
  color: var(--ink);
  text-decoration: none;
  transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}
.card-action::after {
  content: "↗";
  font-size: 13px;
  letter-spacing: 0;
  margin-left: var(--s2);
  transition: transform 0.15s ease;
}
.card-action:hover { background: var(--ink); color: var(--paper); }
.card-action:hover::after { transform: translate(2px, -2px); }
.card-action:focus-visible { outline: 2px solid var(--marigold); outline-offset: 2px; }

.card-action-primary {
  background: var(--marigold);
  border-color: var(--marigold);
  color: #fff;
}
.card-action-primary:hover {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--paper);
}

/* ---------- Claude rec badge (candidate cards only) ---------- */
.rec-badge {
  display: inline-block;
  margin-left: var(--s2);
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em;
  text-transform: uppercase; padding: 2px var(--s2);
  border: 1px solid;
}
.rec-add      { color: var(--marigold); background: var(--marigold-soft); border-color: var(--marigold); }
.rec-watch    { color: var(--jade);     background: var(--jade-soft);     border-color: var(--jade); }
.rec-reject   { color: var(--ink-3);    background: transparent;          border-color: var(--rule); }
.rec-pending  { color: var(--ink-3);    background: transparent;          border-color: var(--rule); font-style: italic; }
.rec-archive  { color: var(--ink);      background: var(--paper-2);       border-color: var(--ink); }
.tier-unscored { background: var(--paper-2); color: var(--ink-3); }

/* ---------- Events ---------- */
.events-section { padding: var(--s8) 0 0; }
.event-list { list-style: none; padding: 0; margin: 0; }
.event-item {
  display: grid;
  grid-template-columns: 140px 1fr auto;
  gap: var(--s4); align-items: baseline;
  padding: var(--s4) 0;
  border-bottom: 1px solid var(--rule-soft);
}
.event-date {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--marigold);
}
.event-title {
  font-family: var(--font-display); font-size: 22px; font-weight: 400;
  letter-spacing: -0.01em;
  color: var(--ink); margin: 0 0 var(--s1);
}
.event-snippet { font-size: 12px; color: var(--ink-2); margin: 0; }
.event-source {
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
  text-align: right;
}
.event-source a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
.event-source a:hover { color: var(--ink); }

/* ---------- Print ---------- */
@media print {
  body { background: white; }
  .toolbar, .topbar { display: none; }
  .grid { gap: var(--s3); grid-template-columns: 1fr 1fr; }
  .card { box-shadow: none; break-inside: avoid; page-break-inside: avoid; }
  .hero { padding: var(--s5) 0; }
}

/* ---------- Empty state ---------- */
.empty {
  text-align: center; padding: var(--s10) var(--s5);
  font-family: var(--font-display); font-style: italic; font-size: 22px;
  color: var(--ink-3);
  display: none;
}
.empty.is-on { display: block; }
</style>
</head>
<body>

<div class="shell">

  <!-- Topbar — wordmark left, meta right -->
  <header class="topbar">
    <a class="wm" href="#" aria-label="UpperCloud Media">
      <img src="assets/uppercloud-logo.png" alt="UpperCloud" />
    </a>
    <div class="topbar-meta">
      <span><b>Field Brief</b> · No. 014</span>

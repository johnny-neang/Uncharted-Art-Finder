<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sacramento Artist Directory — Arden Fair UnchARTed · UpperCloud Studio</title>
<meta name="description" content="A curated directory of 21 Sacramento-area artists and art agencies, evaluated for the Arden Fair UnchARTed program by UpperCloud Studio.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=IBM+Plex+Sans:wght@300;400;500;600&family=Unbounded:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ---------- UpperCloud Brand System (BG—2026.001) ---------- */
:root {
  /* Surfaces */
  --paper: #F5F3EE;
  --paper-2: #EBE7DF;
  --paper-3: #FBF8F2;
  --ink: #1A1A1A;
  --ink-2: #4A4A4A;
  --ink-3: #8A8A8A;
  --rule: rgba(26,26,26,0.15);
  --rule-soft: rgba(26,26,26,0.08);

  /* Inverse */
  --obsidian: #161310;
  --obsidian-2: #2A2522;

  /* Accents — landmarks, not decoration */
  --marigold: #E89A1C;
  --marigold-soft: rgba(232,154,28,0.12);
  --jade: #1F8A76;
  --jade-soft: rgba(31,138,118,0.10);
  --cyan: #23B4D8;

  /* Type families */
  --font-display: "DM Serif Display", "Iowan Old Style", Georgia, serif;
  --font-body: "IBM Plex Sans", system-ui, -apple-system, sans-serif;
  --font-label: "Unbounded", system-ui, sans-serif;

  /* Spacing scale (multiples of 4) */
  --s1: 4px;  --s2: 8px;  --s3: 12px; --s4: 18px;
  --s5: 24px; --s6: 28px; --s7: 36px; --s8: 48px;
  --s9: 64px; --s10: 72px;

  --shadow-card: 0 1px 0 rgba(26,26,26,0.04), 0 8px 24px -10px rgba(26,26,26,0.10);
  --shadow-thumb: inset 0 0 0 1px rgba(26,26,26,0.06);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.55;
  color: var(--ink-2);
  background: var(--paper);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* ---------- Layout ---------- */
.shell { max-width: 1320px; margin: 0 auto; padding: 0 var(--s6); }

/* ---------- Top bar (header chrome — wordmark left, meta right) ---------- */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--s6) 0 var(--s5);
  border-bottom: 1px solid var(--rule-soft);
}
.wm img { height: 28px; display: block; }
.topbar-meta {
  display: flex; gap: var(--s7); align-items: baseline;
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
}
.topbar-meta b { color: var(--ink); font-weight: 500; }

/* ---------- Hero (cover-style) ---------- */
.hero {
  padding: var(--s10) 0 var(--s8);
  border-bottom: 1px solid var(--ink);
  position: relative;
}
.hero-figno {
  font-family: var(--font-label); font-weight: 500;
  font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--marigold);
  margin-bottom: var(--s2);
}
.hero-doctype {
  font-family: var(--font-label); font-weight: 500;
  font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--ink-2);
  margin-bottom: var(--s7);
}
.hero-grid {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: var(--s8);
  align-items: end;
}
.hero h1 {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(48px, 7vw, 96px);
  line-height: 0.96;
  letter-spacing: -0.025em;
  margin: 0 0 var(--s4);
  color: var(--ink);
  max-width: 14ch;
}
.hero h1 em {
  font-style: italic; color: var(--jade);
}
.hero-lede {
  font-family: var(--font-body); font-weight: 300;
  font-size: 18px; line-height: 1.5; color: var(--ink);
  max-width: 56ch;
  margin: 0;
}
.hero-meta {
  border-top: 1px solid var(--ink);
  padding-top: var(--s5);
  display: grid; grid-template-columns: 1fr; gap: var(--s4);
}
.hero-meta dl { margin: 0; display: grid; grid-template-columns: 1fr; gap: var(--s4); }
.hero-meta dt {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3); margin-bottom: var(--s1);
}
.hero-meta dd {
  margin: 0;
  font-family: var(--font-body); font-size: 16px; color: var(--ink);
}

/* ---------- Stats strip ---------- */
.stats {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  border-bottom: 1px solid var(--rule);
}
.stat {
  padding: var(--s5) var(--s5) var(--s4);
  border-right: 1px solid var(--rule-soft);
}
.stat:last-child { border-right: 0; }
.stat-num {
  font-family: var(--font-display);
  font-size: 48px;
  line-height: 1;
  color: var(--ink);
  margin-bottom: var(--s1);
  letter-spacing: -0.02em;
}
.stat-num em { font-style: italic; color: var(--marigold); }
.stat-lbl {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
}

/* ---------- Filters / toolbar ---------- */
.toolbar {
  display: flex;
  align-items: center;
  gap: var(--s4);
  padding: var(--s5) 0 var(--s4);
  border-bottom: 1px solid var(--rule-soft);
  flex-wrap: wrap;
}
.toolbar-label {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--ink-3);
  margin-right: var(--s1);
}
.chip {
  display: inline-flex; align-items: center; gap: var(--s2);
  padding: 6px var(--s3);
  border: 1px solid var(--rule);
  background: transparent;
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-2);
  cursor: pointer;
  transition: all 0.15s;
  user-select: none;
  line-height: 1.6;
}
.chip:hover { color: var(--ink); border-color: var(--ink); }
.chip[aria-pressed="true"] {
  background: var(--ink); color: var(--paper); border-color: var(--ink);
}
.chip .chip-count {
  font-size: 9px; opacity: 0.6; font-weight: 400; letter-spacing: 0.1em;
}
.search-wrap { margin-left: auto; }
.search {
  border: 1px solid var(--rule);
  background: transparent;
  padding: 7px var(--s3);
  font-size: 13px;
  font-family: var(--font-body);
  color: var(--ink);
  width: 240px;
}
.search:focus { outline: none; border-color: var(--ink); }
.search::placeholder {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
}

/* ---------- Section eyebrow (NN — LABEL — JADE RULE) ---------- */
.section-head {
  padding: var(--s8) 0 var(--s5);
  margin-bottom: var(--s6);
}
.eyebrow {
  display: flex; align-items: center; gap: var(--s4);
  margin-bottom: var(--s4);
}
.eyebrow .num {
  font-family: var(--font-label); font-weight: 500;
  font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--marigold);
}
.eyebrow .lbl {
  font-family: var(--font-label); font-weight: 500;
  font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--ink);
}
.eyebrow .line { flex: 1; height: 1px; background: var(--jade); }
.eyebrow .meta {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
}
.section-title {
  font-family: var(--font-display);
  font-size: 38px;
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: -0.015em;
  margin: 0;
  color: var(--ink);
}
.section-title em { font-style: italic; color: var(--jade); }
.section-meta { font-family: var(--font-label); font-weight: 500; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-3); }

/* ---------- Card grid ---------- */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--s6);
  padding-bottom: var(--s10);
}
@media (max-width: 920px) {
  .grid { grid-template-columns: 1fr; }
  .hero-grid { grid-template-columns: 1fr; }
  .stats { grid-template-columns: repeat(2, 1fr); }
}

.card {
  background: var(--paper);
  border: 1px solid var(--rule);
  padding: var(--s5);
  display: flex; flex-direction: column;
  position: relative;
  transition: border-color 0.15s;
  box-shadow: var(--shadow-card);
}
.card:hover { border-color: var(--ink); }
.card.is-hidden { display: none; }

.card-head {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: var(--s4);
  margin-bottom: var(--s3);
}
.card-num {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--marigold);
  margin-bottom: var(--s1);
}
.card-name {
  font-family: var(--font-display);
  font-size: 28px;
  line-height: 1.05;
  font-weight: 400;
  margin: 0 0 var(--s1);
  letter-spacing: -0.015em;
  color: var(--ink);
}
.card-name em { font-style: italic; color: var(--jade); }
.card-sub {
  font-size: 12px; color: var(--ink-2);
  display: flex; gap: var(--s2); align-items: center; flex-wrap: wrap;
}

.tier-badge {
  display: inline-flex; align-items: center; gap: var(--s1);
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 4px var(--s2);
  white-space: nowrap;
  flex-shrink: 0;
  border: 1px solid;
}
.tier-1 { color: var(--marigold); border-color: var(--marigold); background: var(--marigold-soft); }
.tier-2 { color: var(--jade); border-color: var(--jade); background: var(--jade-soft); }
.tier-3 { color: var(--ink-2); border-color: var(--rule); background: transparent; }

.kind-pill {
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3); padding: 3px 0;
}

/* ---------- Thumb grid ---------- */
.thumb-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s2);
  margin: var(--s1) 0 var(--s4);
}
.thumb {
  position: relative;
  aspect-ratio: 4 / 3;
  background: var(--paper-2);
  overflow: hidden;
  box-shadow: var(--shadow-thumb);
}
.thumb svg, .thumb img { width: 100%; height: 100%; display: block; }
.thumb-label {
  position: absolute;
  left: var(--s2); bottom: var(--s2);
  font-family: var(--font-label); font-weight: 500;
  font-size: 8px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  background: rgba(26, 26, 26, 0.82);
  color: var(--paper);
  padding: 3px 7px;
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
}

/* ---------- Card body ---------- */
.card-summary {
  font-size: 13px;
  line-height: 1.55;
  color: var(--ink-2);
  margin: 0 0 var(--s4);
}
.card-meta-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s3);
  font-size: 12px;
  margin-top: auto;
  padding-top: var(--s3);
  border-top: 1px solid var(--rule-soft);
}
.card-meta-cell { display: flex; flex-direction: column; gap: var(--s1); }
.card-meta-cell dt {
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
}
.card-meta-cell dd {
  font-family: var(--font-body); font-size: 12px; color: var(--ink); margin: 0;
}

.fit-bar {
  display: flex; align-items: center; gap: var(--s2);
}
.fit-dots { display: flex; gap: 2px; }
.fit-dot {
  width: 6px; height: 6px; background: var(--rule);
}
.fit-dot.on { background: var(--marigold); }
.fit-num { font-family: var(--font-label); font-weight: 500; font-size: 9px; letter-spacing: 0.18em; color: var(--ink-3); text-transform: uppercase; }

.card-foot {
  display: flex; justify-content: space-between; align-items: center;
  padding-top: var(--s3);
  font-size: 12px;
}
.card-link {
  color: var(--ink); text-decoration: none;
  border-bottom: 1px solid var(--ink);
  padding-bottom: 1px;
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
}
.card-link:hover { color: var(--jade); border-bottom-color: var(--jade); }
.card-link::after { content: " →"; }
.card-tags { display: flex; gap: var(--s1); flex-wrap: wrap; }
.tag {
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-2); padding: 2px var(--s2);
  border: 1px solid var(--rule);
}

/* ---------- Footer ---------- */
.footer {
  border-top: 1px solid var(--ink);
  padding: var(--s8) 0 var(--s9);
  margin-top: var(--s5);
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: var(--s8);
  font-size: 13px;
  color: var(--ink-2);
}
.footer h4 {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--ink); margin: 0 0 var(--s3);
}
.footer p { margin: 0 0 var(--s2); line-height: 1.55; }
.footer-meta {
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
}
.footer-meta b { color: var(--ink); font-weight: 500; }
.footer .pg {
  font-family: var(--font-display); font-size: 22px;
  letter-spacing: 0; text-transform: none; color: var(--ink);
}


/* ---------- Directory state filter (in-directory / returned / archived) ---------- */
.directory-filter-row {
  display: flex; align-items: center; flex-wrap: wrap; gap: var(--s2);
  margin: var(--s3) 0 var(--s5);
}
.directory-filter-chip {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  padding: 6px var(--s3);
  border: 1px solid var(--rule);
  background: transparent;
  color: var(--ink-2);
  cursor: pointer;
  transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}
.directory-filter-chip:hover { border-color: var(--ink); color: var(--ink); }
.directory-filter-chip[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.directory-filter-chip[data-state="returned"][aria-pressed="true"] { background: var(--marigold); border-color: var(--marigold); color: #fff; }
.directory-filter-chip[data-state="archive"][aria-pressed="true"]  { background: var(--ink-3); border-color: var(--ink-3); color: var(--paper); }
.directory-filter-chip .count { color: inherit; opacity: 0.55; margin-left: 6px; }

/* Per-card state dropdown (mirrors .discovery-rec-select but slightly smaller/right-aligned) */
.card-state-select {
  appearance: none; -webkit-appearance: none; -moz-appearance: none;
  border: 1px solid var(--rule); background: transparent;
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--ink-2);
  padding: 4px 18px 4px var(--s2); margin-left: auto;
  cursor: pointer;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 5'><path d='M0 0L4 5L8 0Z' fill='currentColor'/></svg>");
  background-repeat: no-repeat;
  background-position: right 6px center;
  background-size: 7px 4px;
}
.card-state-select[data-state="returned"] { color: var(--marigold); border-color: var(--marigold); }
.card-state-select[data-state="archive"]  { color: var(--ink-3); border-color: var(--ink-3); }
.card-state-select:focus { outline: 1px dashed var(--ink); outline-offset: 2px; }
.card-state-select option { font-family: var(--font-body); letter-spacing: 0; text-transform: none; color: var(--ink); }

/* ---------- Promoted from discoveries (sits between directory + discoveries) ---------- */
.promoted-section { padding: var(--s7) 0 0; }
.promoted-section[hidden] { display: none; }
.promoted-eyebrow {
  display: flex; align-items: baseline; gap: var(--s3);
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--marigold);
  margin-bottom: var(--s3);
}
.promoted-eyebrow .line { flex: 1; height: 1px; background: var(--marigold); opacity: 0.4; }
.promoted-eyebrow .meta { color: var(--ink-3); font-weight: 400; letter-spacing: 0.18em; }

/* ---------- Discoveries ---------- */
.discoveries-section { padding: var(--s8) 0 0; }
.discovery-filter-row {
  display: flex; align-items: center; flex-wrap: wrap; gap: var(--s2);
  margin: var(--s4) 0 var(--s4);
}
.discovery-filter-label {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--ink-3); margin-right: var(--s2);
}
.discovery-filter-chip {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
  padding: 6px var(--s3);
  border: 1px solid var(--rule);
  background: transparent;
  color: var(--ink-2);
  cursor: pointer;
  transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}
.discovery-filter-chip:hover { border-color: var(--ink); color: var(--ink); }
.discovery-filter-chip[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.discovery-filter-chip .count { color: inherit; opacity: 0.55; margin-left: 6px; }
.discovery-filter-chip[data-state="add"][aria-pressed="true"]     { background: var(--marigold); border-color: var(--marigold); color: #fff; }
.discovery-filter-chip[data-state="watch"][aria-pressed="true"]   { background: var(--jade); border-color: var(--jade); color: #fff; }
.discovery-filter-chip[data-state="reject"][aria-pressed="true"]  { background: var(--ink-3); border-color: var(--ink-3); color: var(--paper); }
.discovery-filter-chip[data-state="archive"][aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
.discovery-empty-state {
  padding: var(--s6); border: 1px dashed var(--rule);
  color: var(--ink-3); font-style: italic; text-align: center;
  display: none;
}
.discovery-empty-state.is-on { display: block; }
.submit-url-cta {
  display: inline-flex; align-items: center; gap: 8px;
  margin-top: var(--s4);
  padding: 10px 18px;
  border: 1px solid var(--jade);
  border-radius: 999px;
  font-family: var(--font-label); font-weight: 500;
  font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--jade);
  text-decoration: none;
  transition: background-color 0.15s ease, color 0.15s ease;
}
.submit-url-cta:hover { background: var(--jade); color: #fff; }
.submit-url-cta .plus { font-size: 16px; line-height: 1; margin-top: -2px; }
.submit-url-cta .hint { color: var(--ink-3); margin-left: 12px; font-size: 10px; letter-spacing: 0.14em; }
.discovery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: var(--s4);
  margin-bottom: var(--s5);
}
.discovery-card {
  background: var(--paper);
  border: 1px solid var(--rule);
  padding: var(--s3);
  display: flex; flex-direction: column;
}
.discovery-thumb {
  aspect-ratio: 4 / 3; background: var(--paper-2);
  overflow: hidden;
  position: relative; margin-bottom: var(--s3);
  box-shadow: var(--shadow-thumb);
}
.discovery-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.discovery-thumb-fallback {
  position: absolute; inset: 0; display: grid; place-items: center;
  font-family: var(--font-display); font-style: italic; font-size: 14px;
  color: var(--ink-3);
}
.discovery-name {
  font-family: var(--font-display); font-size: 22px; font-weight: 400;
  margin: 0 0 var(--s1); line-height: 1.1;
  letter-spacing: -0.01em;
  color: var(--ink);
}
.discovery-name em { font-style: italic; color: var(--jade); }
.discovery-source {
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
  margin-bottom: var(--s2);
}
.discovery-summary { font-size: 12px; color: var(--ink-2); margin: 0 0 var(--s3); line-height: 1.5; }
.discovery-actions {
  display: flex; gap: var(--s2); align-items: center; margin-top: auto;
  padding-top: var(--s2); border-top: 1px solid var(--rule-soft);
  font-size: 11px;
}
.discovery-rec {
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em;
  text-transform: uppercase; padding: 3px var(--s2);
  border: 1px solid;
}
.rec-add      { color: var(--marigold); background: var(--marigold-soft); border-color: var(--marigold); }
.rec-watch    { color: var(--jade);     background: var(--jade-soft);     border-color: var(--jade); }
.rec-reject   { color: var(--ink-3);    background: transparent;          border-color: var(--rule); }
.rec-pending  { color: var(--ink-3);    background: transparent;          border-color: var(--rule); font-style: italic; }
.rec-archive  { color: var(--ink);      background: var(--paper-2);       border-color: var(--ink); }
.discovery-rec-select {
  appearance: none; -webkit-appearance: none; -moz-appearance: none;
  border: 1px solid currentColor; background: transparent;
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  padding: 3px 18px 3px var(--s2); margin: 0;
  cursor: pointer;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 5'><path d='M0 0L4 5L8 0Z' fill='currentColor'/></svg>");
  background-repeat: no-repeat;
  background-position: right 6px center;
  background-size: 7px 4px;
}
.discovery-rec-select:focus { outline: 1px dashed var(--ink); outline-offset: 2px; }
.discovery-rec-select option { font-family: var(--font-body); letter-spacing: 0; text-transform: none; color: var(--ink); }
.discovery-link {
  margin-left: auto; color: var(--ink); text-decoration: none;
  border-bottom: 1px solid var(--ink); padding-bottom: 1px;
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
}
.discovery-link:hover { color: var(--jade); border-bottom-color: var(--jade); }

/* ---------- Events ---------- */
.events-section { padding: var(--s8) 0 0; }
.event-list { list-style: none; padding: 0; margin: 0; }
.event-item {
  display: grid;
  grid-template-columns: 140px 1fr auto;
  gap: var(--s4); align-items: baseline;
  padding: var(--s4) 0;
  border-bottom: 1px solid var(--rule-soft);
}
.event-date {
  font-family: var(--font-label); font-weight: 500;
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--marigold);
}
.event-title {
  font-family: var(--font-display); font-size: 22px; font-weight: 400;
  letter-spacing: -0.01em;
  color: var(--ink); margin: 0 0 var(--s1);
}
.event-snippet { font-size: 12px; color: var(--ink-2); margin: 0; }
.event-source {
  font-family: var(--font-label); font-weight: 500;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
  text-align: right;
}
.event-source a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
.event-source a:hover { color: var(--ink); }

/* ---------- Print ---------- */
@media print {
  body { background: white; }
  .toolbar, .topbar { display: none; }
  .grid { gap: var(--s3); grid-template-columns: 1fr 1fr; }
  .card { box-shadow: none; break-inside: avoid; page-break-inside: avoid; }
  .hero { padding: var(--s5) 0; }
}

/* ---------- Empty state ---------- */
.empty {
  text-align: center; padding: var(--s10) var(--s5);
  font-family: var(--font-display); font-style: italic; font-size: 22px;
  color: var(--ink-3);
  display: none;
}
.empty.is-on { display: block; }
</style>
</head>
<body>

<div class="shell">

  <!-- Topbar — wordmark left, meta right -->
  <header class="topbar">
    <a class="wm" href="#" aria-label="UpperCloud Media">
      <img src="assets/uppercloud-logo.png" alt="UpperCloud" />
    </a>
    <div class="topbar-meta">
      <span><b>Field Brief</b> · No. 014</span>
      <span>Sacramento <b>·</b> CA</span>
      <span id="lastReviewed">Reviewed {{LAST_REVIEWED}}</span>
    </div>
  </header>

  <!-- Hero (cover) -->
  <section class="hero">
    <div class="hero-figno">FIG. 01 / DIRECTORY</div>
    <div class="hero-doctype">Field Brief — No. 014 · Public Art</div>
    <div class="hero-grid">
      <div>
        <h1>Sacramento <em>artist</em><br>directory.</h1>
        <p class="hero-lede">
          A working catalog of twenty-one Sacramento-area artists and art agencies,
          shortlisted and assessed for the Arden Fair UnchARTed program. Curated,
          sequenced, and graded by UpperCloud Studio for client use.
        </p>
      </div>
      <aside class="hero-meta">
        <dl>
          <div>
            <dt>Client</dt>
            <dd>Arden Fair · Sacramento</dd>
          </div>
          <div>
            <dt>Program</dt>
            <dd>UnchARTed · 2026 cycle</dd>
          </div>
          <div>
            <dt>Brief</dt>
            <dd>Indoor mural &amp; rotating installs</dd>
          </div>
          <div>
            <dt>Curator</dt>
            <dd>UpperCloud Studio</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats">
    <div class="stat"><div class="stat-num">21</div><div class="stat-lbl">Total entries</div></div>
    <div class="stat"><div class="stat-num"><em>7</em></div><div class="stat-lbl">Tier-one priorities</div></div>
    <div class="stat"><div class="stat-num">11</div><div class="stat-lbl">Tier-two established</div></div>
    <div class="stat"><div class="stat-num">3</div><div class="stat-lbl">Agencies / curators</div></div>
    <div class="stat"><div class="stat-num">42</div><div class="stat-lbl">Visual references</div></div>
  </section>

  <!-- Filter toolbar -->
  <div class="toolbar" role="toolbar" aria-label="Filter directory">
    <span class="toolbar-label">Filter</span>
    <button class="chip" data-filter="all" aria-pressed="true">All <span class="chip-count">21</span></button>
    <button class="chip" data-filter="tier-1" aria-pressed="false">Tier 1 <span class="chip-count">7</span></button>
    <button class="chip" data-filter="tier-2" aria-pressed="false">Tier 2 <span class="chip-count">11</span></button>
    <button class="chip" data-filter="tier-3" aria-pressed="false">Agencies <span class="chip-count">3</span></button>
    <button class="chip" data-filter="mural" aria-pressed="false">Murals</button>
    <button class="chip" data-filter="studio" aria-pressed="false">Studio &amp; canvas</button>
    <button class="chip" data-filter="best-fit" aria-pressed="false">Best fit · 4+</button>
    <span class="search-wrap"><input class="search" type="search" id="searchInput" placeholder="Search · name, medium, work"></span>
  </div>

  <!-- Directory section header -->
  <div class="section-head">
    <div class="eyebrow">
      <span class="num">02</span>
      <span class="lbl">The Directory</span>
      <span class="line"></span>
      <span class="meta">Sequenced by tier &amp; fit · 21 entries</span>
    </div>
    <h2 class="section-title">The <em>directory</em>.</h2>
  </div>

  <!-- State filter chips: parallel to discoveries section's filter row -->
  <div class="directory-filter-row" role="toolbar" aria-label="Filter directory by state">
    <span class="discovery-filter-label">View</span>
    <button class="directory-filter-chip" data-state="directory" aria-pressed="true">In directory <span class="count" data-dir-count="directory">0</span></button>
    <button class="directory-filter-chip" data-state="returned" aria-pressed="false">Returned <span class="count" data-dir-count="returned">0</span></button>
    <button class="directory-filter-chip" data-state="archive" aria-pressed="false">Archived <span class="count" data-dir-count="archive">0</span></button>
  </div>

  <!-- Cards grid -->
  <main class="grid" id="cardGrid"></main>
  <!-- Returned from directory (cards demoted back to discoveries via dropdown) -->
  <main class="grid" id="returnedGrid" hidden></main>
  <!-- Archived directory cards -->
  <main class="grid" id="archivedGrid" hidden></main>

  <div class="empty" id="empty">Nothing matches that filter.</div>

  <!-- Promoted from discoveries (candidates marked `add` move here) -->
  <section id="promoted-section" class="promoted-section" hidden>
    <div class="promoted-eyebrow">
      <span>Promoted from discoveries</span>
      <span class="line"></span>
      <span class="meta" id="promoted-meta">0 candidates promoted to the directory</span>
    </div>
    <div class="discovery-grid" id="promotedGrid"></div>
  </section>

  <!-- Discoveries section -->
  <section id="discoveries-section" class="discoveries-section" hidden>
    <div class="section-head">
      <div class="eyebrow">
        <span class="num">03</span>
        <span class="lbl">Discoveries</span>
        <span class="line"></span>
        <span class="meta" id="discoveries-meta">Surfaced today by the daily scanner</span>
      </div>
      <h2 class="section-title">Recent <em>candidates</em>.</h2>
      <a class="submit-url-cta"
         href="https://github.com/johnny-neang/Uncharted-Art-Finder/issues/new?template=seed.yml"
         target="_blank" rel="noopener"
         title="Opens a GitHub Issue to submit a URL — picked up by the next /refresh">
        <span class="plus">+</span> Submit an artist URL
        <span class="hint">picked up on next refresh</span>
      </a>
    </div>
    <div class="discovery-filter-row" id="discoveryFilterRow" role="toolbar" aria-label="Filter discoveries by state">
      <span class="discovery-filter-label">View</span>
      <button class="discovery-filter-chip" data-state="all" aria-pressed="true">All <span class="count" data-count="all">0</span></button>
      <button class="discovery-filter-chip" data-state="pending" aria-pressed="false">Pending <span class="count" data-count="pending">0</span></button>
      <button class="discovery-filter-chip" data-state="watch" aria-pressed="false">Watch <span class="count" data-count="watch">0</span></button>
      <button class="discovery-filter-chip" data-state="add" aria-pressed="false">Add <span class="count" data-count="add">0</span></button>
      <button class="discovery-filter-chip" data-state="reject" aria-pressed="false">Reject <span class="count" data-count="reject">0</span></button>
      <button class="discovery-filter-chip" data-state="archive" aria-pressed="false">Archive <span class="count" data-count="archive">0</span></button>
    </div>
    <div class="discovery-grid" id="discoveryGrid"></div>
    <div class="discovery-empty-state" id="discoveryEmpty">No candidates match this filter.</div>
  </section>

  <!-- Events section -->
  <section id="events-section" class="events-section" hidden>
    <div class="section-head">
      <div class="eyebrow">
        <span class="num">04</span>
        <span class="lbl">Upcoming Events</span>
        <span class="line"></span>
        <span class="meta">Sacramento art calendar · refreshed daily</span>
      </div>
      <h2 class="section-title">What's <em>on</em>.</h2>
    </div>
    <ul class="event-list" id="eventList"></ul>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div>
      <h4>About this brief</h4>
      <p>Compiled by UpperCloud Studio for the Arden Fair UnchARTed program. Each entry is graded on a four-axis fit score — style, scale, audience, availability — and accompanied by two visual references from the artist's recent portfolio.</p>
      <p class="footer-meta">Field Brief · No. 014 · Cycle 2026</p>
    </div>
    <div>
      <h4>How to use this</h4>
      <p>Filter by tier or medium to narrow shortlists. Each card links out to the artist's primary portfolio. The directory is self-contained — open offline, print, or share the file.</p>
      <p class="footer-meta">Visual references regenerated by the <code>/refresh</code> pipeline. Real photos populate as the daily scrape resolves them.</p>
    </div>
    <div>
      <h4>Contact</h4>
      <p>UpperCloud Studio<br>Sacramento, California<br>hello@uppercloud.studio</p>
      <p class="footer-meta"><b>Authored</b> · {{LAST_REVIEWED}} &nbsp;·&nbsp; <b>Version</b> · 1.0.0</p>
    </div>
  </footer>

</div>

<!-- ============================================================ -->
<!-- ARTIST DATA + SVG LIBRARY + RENDERER                         -->
<!-- ============================================================ -->
<script>
/* SVG art library — each artwork is a hand-tuned vector that
   reflects the artist's actual signature style based on portfolio research.
   Replace any of these with a real <img src="data:..."> via inject_images.py. */

/* {{SVG_LIBRARY}} */

/* ============================================================
   ARTIST DATA TABLE
   ============================================================ */

/* {{ARTISTS_DATA}} */


/* {{DISCOVERIES_DATA}} */
/* {{EVENTS_DATA}} */

/* ============================================================
   RENDER
   ============================================================ */

const grid = document.getElementById("cardGrid");

function renderCard(a) {
  const tierClass = `tier-${a.tier}`;
  const tierLabel = a.tier === 1 ? "Tier 1 · Priority" : a.tier === 2 ? "Tier 2 · Established" : "Tier 3 · Agency";

  const thumbs = a.thumbs.map(t => {
    const art = SVG[t.svg] || `<svg viewBox="0 0 400 300"><rect width="400" height="300" fill="#EAE3D2"/></svg>`;
    return `<div class="thumb">${art}<div class="thumb-label">${t.label}</div></div>`;
  }).join("");

  const fitDots = Array.from({length: 5}, (_, i) =>
    `<span class="fit-dot${i < a.fit ? ' on' : ''}"></span>`
  ).join("");

  const tags = a.tags.map(t => `<span class="tag">${t}</span>`).join("");

  return `
    <article class="card" data-tier="tier-${a.tier}" data-tags="${a.tags.join(' ')}" data-search="${(a.name+' '+a.medium+' '+a.summary+' '+a.tags.join(' ')).toLowerCase()}" data-fit="${a.fit}">
      <header class="card-head">
        <div>
          <div class="card-num">No. ${String(a.n).padStart(2,'0')}</div>
          <h3 class="card-name">${a.name}</h3>
          <div class="card-sub">
            <span class="kind-pill">${a.kind}</span>
          </div>
        </div>
        <span class="tier-badge ${tierClass}">${tierLabel}</span>
      </header>
      <div class="thumb-grid">${thumbs}</div>
      <p class="card-summary">${a.summary}</p>
      <dl class="card-meta-row">
        <div class="card-meta-cell">
          <dt>Medium</dt>
          <dd>${a.medium}</dd>
        </div>
        <div class="card-meta-cell">
          <dt>Arden Fair fit</dt>
          <dd class="fit-bar">
            <span class="fit-dots">${fitDots}</span>
            <span class="fit-num">${a.fit}/5</span>
          </dd>
        </div>
      </dl>
      <p class="card-summary" style="font-size:12px;margin:10px 0 0;color:var(--ink-2);font-style:italic">${a.suitability}</p>
      <div class="card-foot">
        <a class="card-link" href="${a.primaryUrl}" target="_blank" rel="noopener">${a.primaryHost}</a>
        <div class="card-tags">${tags}</div>
        <select class="card-state-select" data-slug="${a.slug}" data-state="${directoryState(a)}" aria-label="Move ${a.name} between directory / returned / archive">
          <option value="directory"${directoryState(a) === "directory" ? " selected" : ""}>in directory</option>
          <option value="returned"${directoryState(a) === "returned" ? " selected" : ""}>returned to discoveries</option>
          <option value="archive"${directoryState(a) === "archive" ? " selected" : ""}>archived</option>
        </select>
      </div>
    </article>
  `;
}

// ----- Directory state (per-card override stored in localStorage) -----
function directoryState(a) {
  let v = null;
  try { v = localStorage.getItem("dir-state:" + a.slug); } catch (_) { /* private mode */ }
  return (v === "returned" || v === "archive") ? v : "directory";
}

function partitionArtists() {
  const buckets = { directory: [], returned: [], archive: [] };
  ARTISTS.forEach(a => buckets[directoryState(a)].push(a));
  return buckets;
}

function renderDirectoryBuckets() {
  const buckets = partitionArtists();
  document.getElementById("cardGrid").innerHTML     = buckets.directory.map(renderCard).join("");
  document.getElementById("returnedGrid").innerHTML = buckets.returned.map(renderCard).join("");
  document.getElementById("archivedGrid").innerHTML = buckets.archive.map(renderCard).join("");
  Object.keys(buckets).forEach(k => {
    const el = document.querySelector(`[data-dir-count="${k}"]`);
    if (el) el.textContent = buckets[k].length;
  });
}

renderDirectoryBuckets();

/* ============================================================
   FILTERS + SEARCH
   ============================================================ */

const chips = document.querySelectorAll(".chip");
const empty = document.getElementById("empty");
const searchInput = document.getElementById("searchInput");

let activeFilter = "all";
let searchTerm = "";

function applyFilters() {
  // Re-query each call: cards are rebuilt by renderDirectoryBuckets() on state changes,
  // so a cached NodeList would point at orphaned DOM nodes.
  const cards = document.querySelectorAll(".card");
  let visible = 0;
  cards.forEach(c => {
    const tier = c.dataset.tier;
    const tags = c.dataset.tags;
    const fit = parseInt(c.dataset.fit, 10);
    const text = c.dataset.search;

    let matchFilter = true;
    if (activeFilter === "tier-1") matchFilter = tier === "tier-1";
    else if (activeFilter === "tier-2") matchFilter = tier === "tier-2";
    else if (activeFilter === "tier-3") matchFilter = tier === "tier-3";
    else if (activeFilter === "mural") matchFilter = tags.includes("mural");
    else if (activeFilter === "studio") matchFilter = tags.includes("studio");
    else if (activeFilter === "best-fit") matchFilter = fit >= 4;

    const matchSearch = !searchTerm || text.includes(searchTerm);
    const visibleNow = matchFilter && matchSearch;
    c.classList.toggle("is-hidden", !visibleNow);
    if (visibleNow) visible++;
  });
  empty.classList.toggle("is-on", visible === 0);
}

chips.forEach(c => c.addEventListener("click", () => {
  chips.forEach(x => x.setAttribute("aria-pressed", "false"));
  c.setAttribute("aria-pressed", "true");
  activeFilter = c.dataset.filter;
  applyFilters();
}));

searchInput.addEventListener("input", e => {
  searchTerm = e.target.value.trim().toLowerCase();
  applyFilters();
});

/* ============================================================
   DIRECTORY STATE (per-card dropdown + state filter chips)
   ============================================================ */

let directoryViewState = "directory"; // "directory" | "returned" | "archive"

function applyDirectoryStateFilter() {
  document.getElementById("cardGrid").hidden     = (directoryViewState !== "directory");
  document.getElementById("returnedGrid").hidden = (directoryViewState !== "returned");
  document.getElementById("archivedGrid").hidden = (directoryViewState !== "archive");
  // Tier/medium filter visibility — only relevant when in the directory view.
  // Other views show whatever's in their bucket regardless.
  const toolbar = document.querySelector(".toolbar");
  if (toolbar) toolbar.style.opacity = (directoryViewState === "directory") ? "1" : "0.5";
}

function wireDirectoryStateChips() {
  document.querySelectorAll(".directory-filter-chip").forEach(chip => {
    chip.addEventListener("click", () => {
      document.querySelectorAll(".directory-filter-chip").forEach(c => c.setAttribute("aria-pressed", "false"));
      chip.setAttribute("aria-pressed", "true");
      directoryViewState = chip.dataset.state;
      applyDirectoryStateFilter();
    });
  });
}

function wireDirectoryStateSelects() {
  document.querySelectorAll(".card-state-select").forEach(sel => {
    sel.addEventListener("change", e => {
      const slug = e.target.dataset.slug;
      const value = e.target.value;
      try {
        if (value === "directory") localStorage.removeItem("dir-state:" + slug);
        else localStorage.setItem("dir-state:" + slug, value);
      } catch (_) { /* private mode */ }
      // Re-render all three buckets so the moved card lands in the right container
      // and counts update. Then re-wire (the new card has new event listeners).
      renderDirectoryBuckets();
      wireDirectoryStateSelects();
      applyDirectoryStateFilter();
    });
  });
}

wireDirectoryStateChips();
wireDirectoryStateSelects();
applyDirectoryStateFilter();

/* ============================================================
   DISCOVERIES + EVENTS (data-driven sections)
   ============================================================ */

const DISCOVERIES = (typeof window.DISCOVERIES !== "undefined") ? window.DISCOVERIES : [];
const EVENTS = (typeof window.EVENTS !== "undefined") ? window.EVENTS : [];

const REC_OPTIONS = ["pending", "add", "watch", "archive", "reject"];
// Legacy "existing" → "archive" normalization on read.
function normalizeRec(rec) {
  return rec === "existing" ? "archive" : rec;
}

function effectiveRec(d) {
  // Local override (browser only) wins; then durable manual_override; then Claude score; else pending.
  let local = null;
  try { local = localStorage.getItem("override:" + d.slug); } catch (_) { /* private/opaque */ }
  if (local) return normalizeRec(local);
  if (d.manual_override) return normalizeRec(d.manual_override);
  if (d.score && d.score.proceed_recommendation) return normalizeRec(d.score.proceed_recommendation);
  return "pending";
}

function renderDiscoveryCard(d) {
  const score = d.score || {};
  const rec = effectiveRec(d);
  const summary = score.one_line_summary || `Surfaced from ${d.source_name}. Awaiting score.`;
  const img = d.image && d.image.data_uri
    ? `<img src="${d.image.data_uri}" alt="${d.name}">`
    : `<div class="discovery-thumb-fallback">No image</div>`;
  const options = REC_OPTIONS.map(o =>
    `<option value="${o}"${o === rec ? " selected" : ""}>${o}</option>`
  ).join("");
  return `
    <article class="discovery-card" data-slug="${d.slug}" data-rec="${rec}">
      <div class="discovery-thumb">${img}</div>
      <h4 class="discovery-name">${d.name}</h4>
      <div class="discovery-source">via ${d.source_name} · ${d.first_seen || ""}</div>
      <p class="discovery-summary">${summary}</p>
      <div class="discovery-actions">
        <select class="discovery-rec discovery-rec-select rec-${rec}" data-slug="${d.slug}" aria-label="Override recommendation for ${d.name}">${options}</select>
        <a class="discovery-link" href="${d.url}" target="_blank" rel="noopener">View →</a>
      </div>
    </article>
  `;
}

// Default state: hide reject + archive; show pending/add/watch.
let discoveryFilter = "all";
const VISIBLE_BY_DEFAULT = new Set(["pending", "add", "watch"]);

function refreshDiscoveryCounts() {
  const counts = { all: 0, pending: 0, add: 0, watch: 0, reject: 0, archive: 0 };
  document.querySelectorAll("[data-slug][data-rec]").forEach(card => {
    if (!card.classList.contains("discovery-card")) return;
    const rec = card.dataset.rec;
    counts.all++;
    if (counts[rec] !== undefined) counts[rec]++;
  });
  Object.keys(counts).forEach(k => {
    const el = document.querySelector(`.discovery-filter-chip [data-count="${k}"]`);
    if (el) el.textContent = counts[k];
  });
}

function applyDiscoveryFilter() {
  let visibleInDiscoveries = 0;
  document.querySelectorAll("#discoveryGrid .discovery-card").forEach(card => {
    const rec = card.dataset.rec;
    const show = (discoveryFilter === "all")
      ? VISIBLE_BY_DEFAULT.has(rec)
      : (rec === discoveryFilter);
    card.style.display = show ? "" : "none";
    if (show) visibleInDiscoveries++;
  });
  // Promoted section visibility: shown when filter is "all" or "add"
  const promoted = document.getElementById("promoted-section");
  const promotedCount = document.querySelectorAll("#promotedGrid .discovery-card").length;
  const promotedVisible = promotedCount > 0 && (discoveryFilter === "all" || discoveryFilter === "add");
  if (promoted) promoted.hidden = !promotedVisible;
  // Empty state: show only when nothing is visible anywhere in the discoveries area
  const empty = document.getElementById("discoveryEmpty");
  if (empty) {
    empty.classList.toggle("is-on", visibleInDiscoveries === 0 && !promotedVisible);
  }
}

function moveCardToContainer(card, targetGridId) {
  const target = document.getElementById(targetGridId);
  if (!target || card.parentElement === target) return;
  target.appendChild(card);
}

function updatePromotedMeta() {
  const meta = document.getElementById("promoted-meta");
  const n = document.querySelectorAll("#promotedGrid .discovery-card").length;
  if (meta) meta.textContent = n === 0
    ? "Promote a discovery candidate by setting its dropdown to “add”."
    : `${n} candidate${n === 1 ? "" : "s"} promoted to the directory`;
}

function wireDiscoveryDropdowns() {
  document.querySelectorAll(".discovery-rec-select").forEach(sel => {
    sel.addEventListener("change", e => {
      const slug = e.target.dataset.slug;
      const value = e.target.value;
      try { localStorage.setItem("override:" + slug, value); } catch (_) { /* private mode */ }
      // Update the badge color class to reflect the new state
      e.target.className = `discovery-rec discovery-rec-select rec-${value}`;
      // Update the card's data-rec for filtering + movement
      const card = e.target.closest(".discovery-card");
      if (!card) return;
      card.dataset.rec = value;
      // Move between containers based on add-status
      if (value === "add") {
        moveCardToContainer(card, "promotedGrid");
      } else {
        moveCardToContainer(card, "discoveryGrid");
      }
      updatePromotedMeta();
      refreshDiscoveryCounts();
      applyDiscoveryFilter();
    });
  });
}

function wireDiscoveryFilterChips() {
  document.querySelectorAll(".discovery-filter-chip").forEach(chip => {
    chip.addEventListener("click", () => {
      document.querySelectorAll(".discovery-filter-chip").forEach(c => c.setAttribute("aria-pressed", "false"));
      chip.setAttribute("aria-pressed", "true");
      discoveryFilter = chip.dataset.state;
      applyDiscoveryFilter();
    });
  });
}

function renderEventItem(e) {
  return `
    <li class="event-item">
      <div class="event-date">${e.date_raw || ""}</div>
      <div>
        <h4 class="event-title">${e.title}</h4>
        <p class="event-snippet">${(e.snippet || "").slice(0, 200)}</p>
      </div>
      <div class="event-source">
        <a href="${e.url}" target="_blank" rel="noopener">${e.source}</a>
      </div>
    </li>
  `;
}

(function mountDiscoveriesAndEvents() {
  const dGrid = document.getElementById("discoveryGrid");
  const pGrid = document.getElementById("promotedGrid");
  const dSection = document.getElementById("discoveries-section");
  if (DISCOVERIES.length > 0) {
    // Partition: anything with effective_rec === "add" goes to the promoted grid
    const promoted = [];
    const regular = [];
    DISCOVERIES.forEach(d => {
      (effectiveRec(d) === "add" ? promoted : regular).push(d);
    });
    pGrid.innerHTML = promoted.map(renderDiscoveryCard).join("");
    dGrid.innerHTML = regular.map(renderDiscoveryCard).join("");
    dSection.hidden = false;
    wireDiscoveryDropdowns();
    wireDiscoveryFilterChips();
    refreshDiscoveryCounts();
    updatePromotedMeta();
    applyDiscoveryFilter();
    // Visible-in-default counter (only pending/add/watch shown by default)
    const visibleByDefault = DISCOVERIES.filter(d => VISIBLE_BY_DEFAULT.has(effectiveRec(d))).length;
    document.getElementById("discoveries-meta").textContent =
      `${visibleByDefault} candidate${visibleByDefault === 1 ? "" : "s"} awaiting review · ${DISCOVERIES.length} total`;
  }
  const eList = document.getElementById("eventList");
  const eSection = document.getElementById("events-section");
  if (EVENTS.length > 0) {
    eList.innerHTML = EVENTS.slice(0, 12).map(renderEventItem).join("");
    eSection.hidden = false;
  }
})();

</script>
</body>
</html>

<!-- ============================================================ -->
<!-- ARTIST DATA + SVG LIBRARY + RENDERER                         -->
<!-- ============================================================ -->
<script>
/* SVG art library — each artwork is a hand-tuned vector that
   reflects the artist's actual signature style based on portfolio research.
   Replace any of these with a real <img src="data:..."> via inject_images.py. */

/* {{SVG_LIBRARY}} */

/* ============================================================
   ARTIST DATA TABLE
   ============================================================ */

/* {{ARTISTS_DATA}} */


/* {{DISCOVERIES_DATA}} */
/* {{EVENTS_DATA}} */

/* ============================================================
   RENDER
   ============================================================ */

const grid = document.getElementById("cardGrid");

const REPO = "johnny-neang/Uncharted-Art-Finder";

// ----- Unified card renderer (used for both Directory and Recent Candidates) -----

function renderThumb(t) {
  // Three thumb shapes in the wild:
  //   - candidate thumbs (from qc_images / ingest_seeds): {data_uri, source_url, kb, label}
  //   - cached directory photos (from build_dashboard.merge_artist_images): {img, label}
  //   - SVG-illustration fallbacks (from data/artists.json): {svg, label}
  const src = (t && (t.data_uri || t.img)) || null;
  if (src) {
    return `<img src="${src}" alt="${(t.label || '').replace(/"/g, '&quot;')}" loading="lazy">`;
  }
  if (t && t.svg) {
    return SVG[t.svg] || `<svg viewBox="0 0 400 300"><rect width="400" height="300" fill="#EAE3D2"/></svg>`;
  }
  return `<svg viewBox="0 0 400 300"><rect width="400" height="300" fill="#EAE3D2"/></svg>`;
}

function actionButton(item) {
  // The anchor's href is the GitHub Issue fallback. Click handlers
  // intercept and POST to /api/promote or /api/demote first; the issue
  // URL is only followed if the API returns an error (e.g. PAT not set,
  // function not yet deployed, etc).
  const nameAttr = (item.name || "").replace(/"/g, '&quot;');
  if (item.mode === "directory") {
    const url = `https://github.com/${REPO}/issues/new?template=demote.yml&title=${encodeURIComponent("Demote: " + item.name)}&slug=${encodeURIComponent(item.slug)}`;
    return `<a class="card-action" href="${url}" target="_blank" rel="noopener"
      data-action="demote" data-slug="${item.slug}" data-name="${nameAttr}"
      title="Move ${nameAttr} back to candidates">Move back to Candidates</a>`;
  }
  const url = `https://github.com/${REPO}/issues/new?template=promote.yml&title=${encodeURIComponent("Promote: " + item.name)}&slug=${encodeURIComponent(item.slug)}`;
  return `<a class="card-action card-action-primary" href="${url}" target="_blank" rel="noopener"
    data-action="promote" data-slug="${item.slug}" data-name="${nameAttr}"
    title="Promote ${nameAttr} to directory">Promote to Directory</a>`;
}

function recBadge(item) {
  if (item.mode !== "candidate") return "";
  const rec = item.rec || "pending";
  return `<span class="rec-badge rec-${rec}">${rec}</span>`;
}

function renderArtCard(item) {
  const tierClass = item.tier ? `tier-${item.tier}` : "tier-unscored";
  const tierLabel = item.tier === 1 ? "Tier 1 · Priority"
                   : item.tier === 2 ? "Tier 2 · Established"
                   : item.tier === 3 ? "Tier 3 · Agency"
                   : "Unscored";

  const thumbsHtml = (item.thumbs || []).map(t =>
    `<div class="thumb">${renderThumb(t)}<div class="thumb-label">${(t.label || '').replace(/</g, '&lt;')}</div></div>`
  ).join("");

  const fitDots = Array.from({length: 5}, (_, i) =>
    `<span class="fit-dot${i < (item.fit || 0) ? ' on' : ''}"></span>`
  ).join("");

  const tagsHtml = (item.tags || []).map(t => `<span class="tag">${t}</span>`).join("");

  const searchBlob = [
    item.name || '', item.medium || '', item.summary || '', (item.tags || []).join(' ')
  ].join(' ').toLowerCase().replace(/"/g, '');

  return `
    <article class="card" data-mode="${item.mode}" data-slug="${item.slug}" data-tier="tier-${item.tier || 0}" data-tags="${(item.tags || []).join(' ')}" data-search="${searchBlob}" data-fit="${item.fit || 0}" data-rec="${item.rec || ''}">
      <header class="card-head">
        <div>
          <div class="card-num">No. ${String(item.n || 0).padStart(2,'0')}</div>
          <h3 class="card-name">${item.name}</h3>
          <div class="card-sub">
            <span class="kind-pill">${item.kind || '—'}</span>
            ${recBadge(item)}
          </div>
        </div>
        <span class="tier-badge ${tierClass}">${tierLabel}</span>
      </header>
      <div class="thumb-grid">${thumbsHtml}</div>
      <p class="card-summary">${item.summary || ''}</p>
      <dl class="card-meta-row">
        <div class="card-meta-cell">
          <dt>Medium</dt>
          <dd>${item.medium || '—'}</dd>
        </div>
        <div class="card-meta-cell">
          <dt>Arden Fair fit</dt>
          <dd class="fit-bar">
            <span class="fit-dots">${fitDots}</span>
            <span class="fit-num">${item.fit || 0}/5</span>
          </dd>
        </div>
      </dl>
      <p class="card-summary" style="font-size:12px;margin:10px 0 0;color:var(--ink-2);font-style:italic">${item.suitability || ''}</p>
      <div class="card-foot">
        <div class="card-foot-action">
          ${actionButton(item)}
          <a class="card-link" href="${item.primaryUrl}" target="_blank" rel="noopener">${item.primaryHost || item.primaryUrl}</a>
        </div>
        <div class="card-tags">${tagsHtml}</div>
      </div>
    </article>
  `;
}

// ----- Adapters: shape ARTISTS / DISCOVERIES into the unified interface -----

function artistToUnified(a) {
  return {
    n: a.n,
    slug: a.slug,
    name: a.name,
    tier: a.tier,
    kind: a.kind,
    medium: a.medium,
    tags: a.tags || [],
    summary: a.summary,
    fit: a.fit,
    suitability: a.suitability,
    primaryUrl: a.primaryUrl,
    primaryHost: a.primaryHost,
    thumbs: a.thumbs || [],
    addedAt: a.addedAt,
    mode: "directory",
  };
}

function candidateToUnified(c, idx) {
  const s = c.score || {};
  let host = "";
  try { host = new URL(c.url).hostname; } catch (_) { /* malformed URL */ }
  return {
    n: idx + 1,
    slug: c.slug,
    name: c.name,
    tier: s.suggested_tier || 0,
    kind: s.kind || c.source_name || "Candidate",
    medium: s.medium || "—",
    tags: s.suggested_tags || [],
    summary: s.one_line_summary || c.seed_description || `Surfaced from ${c.source_name}. Awaiting score.`,
    fit: s.family_fit || 0,
    suitability: s.suitability || "",
    primaryUrl: c.url,
    primaryHost: host,
    thumbs: c.thumbs || (c.image ? [c.image] : []),
    addedAt: c.first_seen,
    mode: "candidate",
    rec: s.proceed_recommendation || "pending",
    confidence: s.confidence,
    sacramento: s.sacramento_connection,
  };
}

grid.innerHTML = ARTISTS.map(a => renderArtCard(artistToUnified(a))).join("");

/* ============================================================
   FILTERS + SEARCH
   ============================================================ */

const chips = document.querySelectorAll(".chip");
const empty = document.getElementById("empty");
const searchInput = document.getElementById("searchInput");

let activeFilter = "all";
let searchTerm = "";

function applyFilters() {
  // Scope to the directory grid — candidate cards use the same .card class
  // but have their own filter chip row.
  const cards = document.querySelectorAll("#cardGrid .card");
  let visible = 0;
  cards.forEach(c => {
    const tier = c.dataset.tier;
    const tags = c.dataset.tags;
    const fit = parseInt(c.dataset.fit, 10);
    const text = c.dataset.search;

    let matchFilter = true;
    if (activeFilter === "tier-1") matchFilter = tier === "tier-1";
    else if (activeFilter === "tier-2") matchFilter = tier === "tier-2";
    else if (activeFilter === "tier-3") matchFilter = tier === "tier-3";
    else if (activeFilter === "mural") matchFilter = tags.includes("mural");
    else if (activeFilter === "studio") matchFilter = tags.includes("studio");
    else if (activeFilter === "best-fit") matchFilter = fit >= 4;

    const matchSearch = !searchTerm || text.includes(searchTerm);
    const visibleNow = matchFilter && matchSearch;
    c.classList.toggle("is-hidden", !visibleNow);
    if (visibleNow) visible++;
  });
  empty.classList.toggle("is-on", visible === 0);
}

chips.forEach(c => c.addEventListener("click", () => {
  chips.forEach(x => x.setAttribute("aria-pressed", "false"));
  c.setAttribute("aria-pressed", "true");
  activeFilter = c.dataset.filter;
  applyFilters();
}));

searchInput.addEventListener("input", e => {
  searchTerm = e.target.value.trim().toLowerCase();
  applyFilters();
});

/* ============================================================
   CANDIDATES + EVENTS (data-driven sections)
   ============================================================ */

const DISCOVERIES = (typeof window.DISCOVERIES !== "undefined") ? window.DISCOVERIES : [];
const EVENTS = (typeof window.EVENTS !== "undefined") ? window.EVENTS : [];

// Effective Claude recommendation, with `existing` legacy normalized to `archive`.
function effectiveRec(d) {
  const raw = (d.manual_override || (d.score && d.score.proceed_recommendation) || "pending");
  return raw === "existing" ? "archive" : raw;
}

// ----- Candidate filter chips (Claude rec subsets) -----

let candidateFilter = "all";

function refreshCandidateCounts() {
  const counts = { all: 0, pending: 0, add: 0, watch: 0, reject: 0, archive: 0 };
  document.querySelectorAll("#discoveryGrid .card").forEach(card => {
    counts.all++;
    const rec = card.dataset.rec || "pending";
    if (counts[rec] !== undefined) counts[rec]++;
  });
  Object.keys(counts).forEach(k => {
    const el = document.querySelector(`.candidate-filter-chip [data-cand-count="${k}"]`);
    if (el) el.textContent = counts[k];
  });
}

function applyCandidateFilter() {
  let visible = 0;
  document.querySelectorAll("#discoveryGrid .card").forEach(card => {
    const rec = card.dataset.rec || "pending";
    const show = (candidateFilter === "all") ? true : (rec === candidateFilter);
    card.style.display = show ? "" : "none";
    if (show) visible++;
  });
  const empty = document.getElementById("discoveryEmpty");
  if (empty) empty.classList.toggle("is-on", visible === 0);
}

function wireCandidateFilterChips() {
  document.querySelectorAll(".candidate-filter-chip").forEach(chip => {
    chip.addEventListener("click", () => {
      document.querySelectorAll(".candidate-filter-chip").forEach(c => c.setAttribute("aria-pressed", "false"));
      chip.setAttribute("aria-pressed", "true");
      candidateFilter = chip.dataset.state;
      applyCandidateFilter();
    });
  });
}

function renderEventItem(e) {
  return `
    <li class="event-item">
      <div class="event-date">${e.date_raw || ""}</div>
      <div>
        <h4 class="event-title">${e.title}</h4>
        <p class="event-snippet">${(e.snippet || "").slice(0, 200)}</p>
      </div>
      <div class="event-source">
        <a href="${e.url}" target="_blank" rel="noopener">${e.source}</a>
      </div>
    </li>
  `;
}

(function mountCandidatesAndEvents() {
  const dGrid = document.getElementById("discoveryGrid");
  const dSection = document.getElementById("discoveries-section");
  if (DISCOVERIES.length > 0) {
    dGrid.innerHTML = DISCOVERIES.map((c, i) => renderArtCard(candidateToUnified(c, i))).join("");
    dSection.hidden = false;
    wireCandidateFilterChips();
    refreshCandidateCounts();
    applyCandidateFilter();
    document.getElementById("discoveries-meta").textContent =
      `${DISCOVERIES.length} candidate${DISCOVERIES.length === 1 ? "" : "s"} · ranked by Claude · you decide what joins the Directory`;
  }
  const eList = document.getElementById("eventList");
  const eSection = document.getElementById("events-section");
  if (EVENTS.length > 0) {
    eList.innerHTML = EVENTS.slice(0, 12).map(renderEventItem).join("");
    eSection.hidden = false;
  }
})();

/* ============================================================
   ONE-CLICK PROMOTE / DEMOTE
   Delegated handler that calls /api/promote or /api/demote.
   Falls back to opening the prefilled GitHub Issue on any error.
   ============================================================ */

(function wireActionButtons() {
  document.addEventListener("click", async (e) => {
    const btn = e.target.closest("[data-action='promote'], [data-action='demote']");
    if (!btn) return;
    // Let modifier-clicks (cmd/ctrl/shift, middle-click) behave normally
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
    e.preventDefault();

    const action = btn.dataset.action;
    const slug = btn.dataset.slug;
    const name = btn.dataset.name || slug;
    const card = btn.closest(".card");
    const originalText = btn.textContent;
    const fallbackUrl = btn.href;

    btn.textContent = "Working…";
    btn.style.pointerEvents = "none";
    btn.style.opacity = "0.65";

    try {
      const resp = await fetch(`/api/${action}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slug }),
      });
      let data = {};
      try { data = await resp.json(); } catch (_) { /* non-JSON body */ }

      if (resp.ok && data.ok) {
        if (card) {
          card.style.transition = "opacity 0.3s ease, transform 0.3s ease";
          card.style.opacity = "0";
          card.style.transform = "scale(0.96)";
          setTimeout(() => {
            card.remove();
            if (action === "promote") refreshCandidateCounts();
          }, 320);
        }
        return;
      }

      // API responded but with an error — fall back to GH Issue.
      const why = (data && data.error) ? data.error : `HTTP ${resp.status}`;
      console.warn(`[${action}] API failed: ${why} — opening GitHub Issue instead`);
      window.open(fallbackUrl, "_blank", "noopener");
    } catch (err) {
      console.warn(`[${action}] network error: ${err.message} — opening GitHub Issue instead`);
      window.open(fallbackUrl, "_blank", "noopener");
    } finally {
      btn.textContent = originalText;
      btn.style.pointerEvents = "";
      btn.style.opacity = "";
    }
  });
})();

</script>
